# CyberMind Analytics - Environment Variables
# Copy this file to .env.local for local development and fill in real values.
# NEVER commit a file containing real API keys - only this placeholder
# template (.env.example) is tracked in version control.
#
# In production (Vercel), these are set as encrypted Production
# environment variables on the project, not committed to git.

# ---- Primary provider: Google Gemini (model: gemini-flash-latest) ----
# Up to 5 candidate keys are supported; the API route rotates across
# them automatically, trying the next one on an auth error, rate limit
# (429), or server error (5xx).
GEMINI_KEY_1=your_gemini_api_key_1_here
GEMINI_KEY_2=your_gemini_api_key_2_here
GEMINI_KEY_3=your_gemini_api_key_3_here
GEMINI_KEY_4=your_gemini_api_key_4_here
GEMINI_KEY_5=your_gemini_api_key_5_here

# ---- Fallback provider: Groq (model: openai/gpt-oss-120b) ----
# Used automatically only if every Gemini key fails. Same rotation
# behavior applies.
GROQ_KEY_1=your_groq_api_key_1_here
GROQ_KEY_2=your_groq_api_key_2_here
GROQ_KEY_3=your_groq_api_key_3_here
GROQ_KEY_4=your_groq_api_key_4_here
GROQ_KEY_5=your_groq_api_key_5_here